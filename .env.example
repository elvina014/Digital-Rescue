# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Domain configuration
# 로컬 개발: http://localhost:3000 / http://login.localhost:3000
# 프로덕션: https://digital-rescue.com / https://login.digital-rescue.com
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://login.localhost:3000

# n8n Webhook
INVENTORY_WEBHOOK_API_KEY=your-webhook-api-key

# n8n AI 사진 인식 워크플로 (Phase 9) — 웹훅 URL과 Header Auth(X-RI-Secret) 값. 실제 값은 저장소에 넣지 않는다
N8N_RI_PHOTO_WEBHOOK_URL=
N8N_RI_PHOTO_SECRET=

# Click Guard (docs/click-guard/SPEC.md) — 네이버 광고 유입 기록
# true 일 때만 수집. Vercel Preview 배포(VERCEL_ENV=preview)에서는 값과 관계없이 수집하지 않는다
CLICK_GUARD_ENABLED=false
# 수집할 호스트(포트 제외, 쉼표 구분). login./edit. 은 넣어도 제외된다
# 운영 예: www.digital-rescue.com,digital-rescue.com  / 로컬: localhost
CLICK_GUARD_ALLOWED_HOSTS=

# 네이버 검색광고 API (docs/click-guard/NAVER-API.md) — ERP에서 광고노출 제한 IP 등록/해제
# 광고주센터 > 도구 > API 사용 관리에서 발급. 서버 전용 값이다: NEXT_PUBLIC_ 접두어를 붙이지 말고 저장소에 실제 값을 넣지 않는다
# 비워 두면 등록/해제 버튼이 "네이버 API 키가 설정되지 않았습니다"를 돌려주고 네이버를 호출하지 않는다
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
NAVER_SA_CUSTOMER_ID=
